# Database
DATABASE_URL="mysql://root:@127.0.0.1:3306/flowline_db"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flowline_db
DB_USER=root
DB_PASSWORD=

# JWT — must be at least 32 characters
JWT_SECRET="flowline_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="8h"

# Session
SESSION_SECRET="flowline_session_secret_key_2026"

# Server
PORT=3001
CLIENT_URL="http://localhost:3001"
UPLOAD_DIR="uploads"

# Overdue job — how often to check for overdue tasks (minutes, default 15)
OVERDUE_CHECK_MINUTES=15
