<div class="grid-2">
  <div class="card">
    <div class="card-header"><span class="card-title">Log Attendance</span></div>
    <form method="POST" action="/manager/attendance">
      <div class="form-group">
        <label class="form-label">Employee *</label>
        <select name="employee_id" class="form-control" required>
          <option value="">Select…</option>
          <% employees.forEach(e=>{ %><option value="<%= e.employee_id %>"><%= e.first_name %> <%= e.last_name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Date *</label><input type="date" name="date" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required/></div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="attendance_status" class="form-control">
            <option value="Present">Present</option><option value="Absent">Absent</option><option value="On Leave">On Leave</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">Time In</label><input type="time" name="time_in" class="form-control"/></div>
        <div class="form-group"><label class="form-label">Time Out</label><input type="time" name="time_out" class="form-control"/></div>
      </div>
      <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Log</button>
    </form>
  </div>
  <div class="card">
    <div class="card-header"><span class="card-title">Filter</span></div>
    <form method="GET" action="/manager/attendance">
      <div class="form-group">
        <label class="form-label">Employee</label>
        <select name="employee_id" class="form-control">
          <option value="">All</option>
          <% employees.forEach(e=>{ %><option value="<%= e.employee_id %>" <%= query.employee_id==e.employee_id?'selected':'' %>><%= e.first_name %> <%= e.last_name %></option><% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group"><label class="form-label">From</label><input type="date" name="from" class="form-control" value="<%= query.from||'' %>"/></div>
        <div class="form-group"><label class="form-label">To</label><input type="date" name="to" class="form-control" value="<%= query.to||'' %>"/></div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
        <a href="/manager/attendance" class="btn btn-secondary btn-sm">Clear</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header"><span class="card-title">Attendance Records (<%= records.length %>)</span></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Employee</th><th>Date</th><th>Time In</th><th>Time Out</th><th>Status</th></tr></thead>
      <tbody>
        <% if (!records.length) { %><tr><td colspan="5"><div class="empty-state"><i class="fa-solid fa-calendar-xmark"></i><p>No records.</p></div></td></tr><% } %>
        <% records.forEach(r=>{ %>
        <tr>
          <td><%= r.employee ? `${r.employee.first_name} ${r.employee.last_name}` : '—' %></td>
          <td><%= r.date %></td><td><%= r.time_in||'—' %></td><td><%= r.time_out||'—' %></td>
          <td><%- attendanceBadge(r.attendance_status) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
