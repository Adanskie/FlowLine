<div class="card">
  <div class="card-header"><span class="card-title">Activity Logs</span></div>
  <form method="GET" action="/admin/activity-logs" class="d-flex gap-2 mb-0" style="flex-wrap:wrap;margin-bottom:16px">
    <input type="text" name="search" class="form-control" placeholder="Search description…" value="<%= query.search||'' %>" style="max-width:220px"/>
    <select name="action_type" class="form-control" style="max-width:160px">
      <option value="">All Actions</option>
      <% ['login','logout','create','update','delete','archive','approval','password_reset','password_reset_request'].forEach(a=>{ %>
        <option value="<%= a %>" <%= query.action_type===a?'selected':'' %>><%= a %></option>
      <% }) %>
    </select>
    <input type="date" name="from" class="form-control" value="<%= query.from||'' %>" style="max-width:160px"/>
    <input type="date" name="to"   class="form-control" value="<%= query.to||'' %>"   style="max-width:160px"/>
    <button type="submit" class="btn btn-secondary btn-sm"><i class="fa-solid fa-magnifying-glass"></i> Filter</button>
    <a href="/admin/activity-logs" class="btn btn-secondary btn-sm">Clear</a>
  </form>

  <div class="table-wrap">
    <table>
      <thead><tr><th>When</th><th>User</th><th>Action</th><th>Description</th><th>Table</th></tr></thead>
      <tbody>
        <% if (!logs.length) { %>
          <tr><td colspan="5"><div class="empty-state"><i class="fa-solid fa-clock-rotate-left"></i><p>No logs found.</p></div></td></tr>
        <% } %>
        <% logs.forEach(l=>{ %>
        <tr>
          <td class="text-muted"><%= new Date(l.created_at).toLocaleString() %></td>
          <td><%= l.user && l.user.employee ? `${l.user.employee.first_name} ${l.user.employee.last_name}` : l.user ? l.user.username : '—' %></td>
          <td><span class="badge badge-progress"><%= l.action_type %></span></td>
          <td><%= l.description %></td>
          <td class="text-muted"><%= l.table_affected||'—' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
