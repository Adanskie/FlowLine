<div class="grid-2">
  <!-- Create/Edit Form -->
  <div class="card">
    <div class="card-header"><span class="card-title">Add Department</span></div>
    <form method="POST" action="/admin/departments">
      <div class="form-group">
        <label class="form-label">Name *</label>
        <input type="text" name="department_name" class="form-control" required/>
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="3"></textarea>
      </div>
      <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add</button>
    </form>
  </div>

  <!-- List -->
  <div class="card">
    <div class="card-header"><span class="card-title">Departments (<%= departments.length %>)</span></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Employees</th><th>Actions</th></tr></thead>
        <tbody>
          <% if (!departments.length) { %><tr><td colspan="3"><p class="text-muted">No departments yet.</p></td></tr><% } %>
          <% departments.forEach(d => { %>
          <tr>
            <td><strong><%= d.department_name %></strong><% if(d.description){ %><br/><small class="text-muted"><%= d.description %></small><% } %></td>
            <td><%= d.employees ? d.employees.length : 0 %></td>
            <td>
              <!-- Inline edit modal trigger -->
              <button class="btn btn-primary btn-sm" onclick="showEditDept(<%= d.department_id %>,'<%= d.department_name.replace(/'/g,`\\'`) %>','<%= (d.description||'').replace(/'/g,`\\'`) %>')"><i class="fa-solid fa-pen"></i></button>
              <form method="POST" action="/admin/departments/<%= d.department_id %>" style="display:inline" onsubmit="return confirm('Delete this department?')">
                <input type="hidden" name="_method" value="DELETE"/>
                <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:200;align-items:center;justify-content:center">
  <div class="card" style="max-width:440px;width:100%;margin:0">
    <div class="card-header"><span class="card-title">Edit Department</span><button class="btn btn-secondary btn-sm" onclick="closeModal()">✕</button></div>
    <form method="POST" id="editForm">
      <input type="hidden" name="_method" value="PUT"/>
      <div class="form-group"><label class="form-label">Name *</label><input type="text" name="department_name" id="editName" class="form-control" required/></div>
      <div class="form-group"><label class="form-label">Description</label><textarea name="description" id="editDesc" class="form-control" rows="3"></textarea></div>
      <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Save</button><button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button></div>
    </form>
  </div>
</div>
<script>
function showEditDept(id, name, desc) {
  document.getElementById('editForm').action = '/admin/departments/' + id;
  document.getElementById('editName').value  = name;
  document.getElementById('editDesc').value  = desc;
  const m = document.getElementById('editModal');
  m.style.display = 'flex';
}
function closeModal() { document.getElementById('editModal').style.display = 'none'; }
</script>
