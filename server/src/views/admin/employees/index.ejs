<div class="card">
  <div class="card-header">
    <span class="card-title">Employees</span>
    <a href="/admin/employees/new" class="btn btn-primary btn-sm"><i class="fa-solid fa-plus"></i> Add Employee</a>
  </div>

  <form method="GET" action="/admin/employees" class="d-flex gap-2 mb-0" style="flex-wrap:wrap;margin-bottom:16px">
    <input type="text" name="search" class="form-control" placeholder="Search…" value="<%= query.search||'' %>" style="max-width:220px"/>
    <select name="department_id" class="form-control" style="max-width:200px">
      <option value="">All Departments</option>
      <% departments.forEach(d => { %><option value="<%= d.department_id %>" <%= query.department_id==d.department_id?'selected':'' %>><%= d.department_name %></option><% }) %>
    </select>
    <select name="status" class="form-control" style="max-width:150px">
      <option value="">All Status</option>
      <option value="Active"    <%= query.status==='Active'?'selected':'' %>>Active</option>
      <option value="Inactive"  <%= query.status==='Inactive'?'selected':'' %>>Inactive</option>
      <option value="Archived"  <%= query.status==='Archived'?'selected':'' %>>Archived</option>
    </select>
    <button type="submit" class="btn btn-secondary btn-sm"><i class="fa-solid fa-magnifying-glass"></i> Filter</button>
    <a href="/admin/employees" class="btn btn-secondary btn-sm">Clear</a>
  </form>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Position</th><th>Role</th><th>Status</th><th>Actions</th></tr></thead>
      <tbody>
        <% if (!employees.length) { %>
          <tr><td colspan="7"><div class="empty-state"><i class="fa-solid fa-users"></i><p>No employees found.</p></div></td></tr>
        <% } %>
        <% employees.forEach(e => { %>
        <tr>
          <td><strong><%= e.first_name %> <%= e.last_name %></strong></td>
          <td><%= e.email %></td>
          <td><%= e.department ? e.department.department_name : '—' %></td>
          <td><%= e.position  ? e.position.position_name   : '—' %></td>
          <td><%= e.user && e.user.role ? e.user.role.role_name : '—' %></td>
          <td><%- statusBadge(e.status) %></td>
          <td class="d-flex gap-2">
            <a href="/admin/employees/<%= e.employee_id %>"       class="btn btn-secondary btn-sm"><i class="fa-solid fa-eye"></i></a>
            <a href="/admin/employees/<%= e.employee_id %>/edit"  class="btn btn-primary btn-sm"><i class="fa-solid fa-pen"></i></a>
            <form method="POST" action="/admin/employees/<%= e.employee_id %>/delete" style="display:inline" onsubmit="return confirm('Archive this employee?')">
              <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-box-archive"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
