<%# Shared task detail partial %>
<div class="d-flex gap-2" style="margin-bottom:16px">
  <a href="javascript:history.back()" class="btn btn-secondary btn-sm"><i class="fa-solid fa-arrow-left"></i> Back</a>
  <% if (canManage) { %>
    <a href="<%= baseUrl %>/edit" class="btn btn-primary btn-sm"><i class="fa-solid fa-pen"></i> Edit</a>
    <form method="POST" action="<%= baseUrl %>?_method=DELETE" style="display:inline" onsubmit="return confirm('Delete?')">
      <input type="hidden" name="_method" value="DELETE"/>
      <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</button>
    </form>
  <% } %>
</div>

<div class="grid-2">
  <div>
    <div class="card">
      <div class="card-header">
        <span class="card-title"><%= task.task_title %></span>
        <%- stageBadge(task.stage ? task.stage.stage_name : '') %>
      </div>
      <p class="text-muted" style="margin-bottom:12px"><%= task.task_description||'No description.' %></p>
      <table style="width:100%;font-size:.88rem">
        <tr><td class="text-muted" style="width:120px">Priority</td><td><%- priorityBadge(task.priority ? task.priority.priority_name : '') %></td></tr>
        <tr><td class="text-muted">Start Date</td><td><%= task.start_date ? new Date(task.start_date).toLocaleDateString() : '—' %></td></tr>
        <tr><td class="text-muted">Due Date</td><td><%= task.due_date ? new Date(task.due_date).toLocaleDateString() : '—' %></td></tr>
        <tr><td class="text-muted">Created by</td><td><%= task.creator && task.creator.employee ? `${task.creator.employee.first_name} ${task.creator.employee.last_name}` : '—' %></td></tr>
      </table>
    </div>

    <% if (canManage) { %>
    <div class="card mt-2">
      <div class="card-header"><span class="card-title">Change Stage</span></div>
      <form method="POST" action="<%= baseUrl %>/change-stage">
        <div class="form-row">
          <div class="form-group">
            <select name="stage_id" class="form-control">
              <% stages.forEach(s => { %><option value="<%= s.stage_id %>" <%= task.stage_id==s.stage_id?'selected':'' %>><%= s.stage_name %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <input type="text" name="remarks" class="form-control" placeholder="Remarks (optional)"/>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Update Stage</button>
      </form>
    </div>

    <% if (task.stage && task.stage.stage_name === 'For Review') { %>
    <div class="card mt-2">
      <div class="card-header"><span class="card-title">Approve / Reject</span></div>
      <form method="POST" action="<%= baseUrl %>/approve">
        <div class="form-group">
          <select name="approval_status" class="form-control">
            <option value="Approved">Approve</option>
            <option value="Rejected">Reject</option>
          </select>
        </div>
        <div class="form-group">
          <textarea name="remarks" class="form-control" rows="2" placeholder="Remarks…"></textarea>
        </div>
        <button type="submit" class="btn btn-success btn-sm">Submit Decision</button>
      </form>
    </div>
    <% } %>
    <% } %>

    <!-- Assignees -->
    <div class="card mt-2">
      <div class="card-header"><span class="card-title">Assignees</span></div>
      <% if (!task.assignments || !task.assignments.length) { %><p class="text-muted">None.</p><% } %>
      <% (task.assignments||[]).forEach(a => { %>
        <div class="d-flex align-center gap-2" style="margin-bottom:8px">
          <div class="avatar" style="background:var(--primary);color:#fff;width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700"><%= a.employee.first_name[0] %></div>
          <div><div style="font-weight:600;font-size:.88rem"><%= a.employee.first_name %> <%= a.employee.last_name %></div><div class="text-muted"><%= a.employee.position ? a.employee.position.position_name : '' %></div></div>
        </div>
      <% }) %>
    </div>
  </div>

  <div>
    <!-- Attachments -->
    <div class="card">
      <div class="card-header"><span class="card-title">Attachments</span></div>
      <% (task.attachments||[]).forEach(att => { %>
        <div class="d-flex align-center gap-2" style="margin-bottom:8px;justify-content:space-between">
          <span><i class="fa-solid fa-file"></i> <%= att.file_name %></span>
          <a href="<%= baseUrl.replace(/\/tasks\/\d+/,'') %>/files/<%= att.attachment_id %>/download" class="btn btn-secondary btn-sm"><i class="fa-solid fa-download"></i></a>
        </div>
      <% }) %>
      <form method="POST" action="<%= baseUrl %>/attachments" enctype="multipart/form-data" class="mt-2">
        <div class="d-flex gap-2">
          <input type="file" name="file" class="form-control" required/>
          <button type="submit" class="btn btn-secondary btn-sm">Upload</button>
        </div>
      </form>
    </div>

    <!-- Comments -->
    <div class="card mt-2">
      <div class="card-header"><span class="card-title">Comments</span></div>
      <% (task.comments||[]).forEach(c => { %>
        <div style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid #f0f0f0">
          <div class="d-flex align-center gap-2" style="margin-bottom:4px">
            <strong style="font-size:.88rem"><%= c.user.employee ? `${c.user.employee.first_name} ${c.user.employee.last_name}` : c.user.username %></strong>
            <span class="text-muted"><%= new Date(c.created_at).toLocaleString() %></span>
            <% if (canManage) { %>
            <form method="POST" action="<%= baseUrl %>/comments/<%= c.comment_id %>/delete" style="margin-left:auto">
              <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i></button>
            </form>
            <% } %>
          </div>
          <p style="font-size:.9rem"><%= c.comment_text %></p>
        </div>
      <% }) %>
      <form method="POST" action="<%= baseUrl %>/comment" class="mt-2">
        <div class="d-flex gap-2">
          <input type="text" name="comment_text" class="form-control" placeholder="Add a comment…" required/>
          <button type="submit" class="btn btn-primary btn-sm">Post</button>
        </div>
      </form>
    </div>

    <!-- Stage History -->
    <div class="card mt-2">
      <div class="card-header"><span class="card-title">History</span></div>
      <% (task.stageHistory||[]).slice(0,8).forEach(h => { %>
        <div style="font-size:.82rem;margin-bottom:8px;color:#374151">
          <span class="text-muted"><%= new Date(h.changed_at).toLocaleString() %></span>
          → <strong><%= h.newStage ? h.newStage.stage_name : '' %></strong>
          <% if (h.remarks) { %> — <%= h.remarks %><% } %>
        </div>
      <% }) %>
    </div>
  </div>
</div>
