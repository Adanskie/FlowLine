<% layout = false %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Forgot Password — Flowline</title>
  <link rel="stylesheet" href="/static/css/app.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo"><i class="fa-solid fa-water"></i> Flowline</div>
    <p class="auth-sub">Forgot your password?</p>

    <% if (error)   { %><div class="alert alert-error"><i class="fa-solid fa-circle-exclamation"></i> <%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= success %></div><% } %>

    <form method="POST" action="/auth/forgot-password">
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" placeholder="Enter your username" required autofocus/>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">
        <i class="fa-solid fa-key"></i> Generate Reset Token
      </button>
    </form>

    <% if (demo_token) { %>
    <div class="alert alert-success mt-2" style="flex-direction:column;align-items:flex-start">
      <strong>Demo Token (copy this):</strong>
      <code style="word-break:break-all;font-size:.82rem;margin-top:6px"><%= demo_token %></code>
    </div>
    <% } %>

    <p style="text-align:center;margin-top:16px;font-size:.85rem">
      <a href="/auth/login" style="color:var(--primary)">Back to login</a>
    </p>
  </div>
</div>
</body>
</html>
