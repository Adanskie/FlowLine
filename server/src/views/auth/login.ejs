<% layout = false %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>Login — Flowline</title>
  <link rel="stylesheet" href="/static/css/app.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo"><i class="fa-solid fa-water"></i> Flowline</div>
    <p class="auth-sub">Workforce Task Management</p>

    <% if (error && error.length > 0) { error.forEach(m => { %>
      <div class="alert alert-error"><i class="fa-solid fa-circle-exclamation"></i> <%= m %></div>
    <% }) } %>
    <% if (success && success.length > 0) { success.forEach(m => { %>
      <div class="alert alert-success"><i class="fa-solid fa-circle-check"></i> <%= m %></div>
    <% }) } %>

    <form method="POST" action="/auth/login">
      <div class="form-group">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" placeholder="Enter username" required autofocus />
      </div>
      <div class="form-group">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" placeholder="Enter password" required />
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:8px">
        <i class="fa-solid fa-right-to-bracket"></i> Sign In
      </button>
    </form>

    <p style="text-align:center;margin-top:16px;font-size:.85rem">
      <a href="/auth/forgot-password" style="color:var(--primary)">Forgot password?</a>
    </p>
  </div>
</div>
</body>
</html>
