<% const today = new Date().toISOString().split('T')[0] %>
<div class="grid-2">
  <div class="card">
    <div class="card-header"><span class="card-title">Today — <%= today %></span></div>
    <% if (!todayRecord) { %>
      <p class="text-muted" style="margin-bottom:12px">You have not timed in yet.</p>
      <form method="POST" action="/employee/attendance/time-in">
        <button type="submit" class="btn btn-success" style="width:100%;justify-content:center">
          <i class="fa-solid fa-right-to-bracket"></i> Time In
        </button>
      </form>
    <% } else if (!todayRecord.time_out) { %>
      <div style="margin-bottom:12px">
        <span class="text-muted">Timed in at:</span> <strong><%= todayRecord.time_in %></strong>
      </div>
      <form method="POST" action="/employee/attendance/time-out">
        <button type="submit" class="btn btn-warning" style="width:100%;justify-content:center">
          <i class="fa-solid fa-right-from-bracket"></i> Time Out
        </button>
      </form>
    <% } else { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        In: <strong><%= todayRecord.time_in %></strong> &nbsp;|&nbsp; Out: <strong><%= todayRecord.time_out %></strong>
      </div>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title">Filter History</span></div>
    <form method="GET" action="/employee/attendance">
      <div class="form-row">
        <div class="form-group"><label class="form-label">From</label><input type="date" name="from" class="form-control" value="<%= query.from||'' %>"/></div>
        <div class="form-group"><label class="form-label">To</label><input type="date" name="to" class="form-control" value="<%= query.to||'' %>"/></div>
      </div>
      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
        <a href="/employee/attendance" class="btn btn-secondary btn-sm">Clear</a>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header"><span class="card-title">Attendance History</span></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Date</th><th>Time In</th><th>Time Out</th><th>Status</th></tr></thead>
      <tbody>
        <% if (!records.length) { %><tr><td colspan="4"><div class="empty-state"><i class="fa-solid fa-calendar-xmark"></i><p>No records.</p></div></td></tr><% } %>
        <% records.forEach(r=>{ %>
        <tr>
          <td><%= r.date %></td>
          <td><%= r.time_in||'—' %></td>
          <td><%= r.time_out||'—' %></td>
          <td><%- attendanceBadge(r.attendance_status) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
