<div class="card">
  <div class="card-header">
    <span class="card-title">My Files</span>
    <form method="GET" action="/employee/files" class="d-flex gap-2">
      <input type="text" name="search" class="form-control" placeholder="Search…" value="<%= query.search||'' %>" style="max-width:220px"/>
      <button type="submit" class="btn btn-secondary btn-sm"><i class="fa-solid fa-magnifying-glass"></i></button>
    </form>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>File</th><th>Task</th><th>Date</th><th></th></tr></thead>
      <tbody>
        <% if (!files.length) { %><tr><td colspan="4"><div class="empty-state"><i class="fa-solid fa-folder-open"></i><p>No files.</p></div></td></tr><% } %>
        <% files.forEach(f=>{ %>
        <tr>
          <td><i class="fa-solid fa-file"></i> <%= f.file_name %></td>
          <td><%= f.task ? f.task.task_title : '—' %></td>
          <td><%= new Date(f.uploaded_at).toLocaleDateString() %></td>
          <td><a href="/employee/files/<%= f.attachment_id %>/download" class="btn btn-secondary btn-sm"><i class="fa-solid fa-download"></i></a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
