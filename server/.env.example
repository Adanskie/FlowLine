# Database
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/flowline_db"

# JWT — must be at least 32 characters
JWT_SECRET="replace-this-with-a-strong-secret-32-chars-minimum"
JWT_EXPIRES_IN="8h"

# Server
PORT=3001
CLIENT_URL="http://localhost:5000"
UPLOAD_DIR="uploads"

# Overdue job — how often to check for overdue tasks (minutes, default 15)
OVERDUE_CHECK_MINUTES=15
