generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id     Int     @id @default(autoincrement())
  role_name   String  @unique
  description String?
  users       User[]

  @@map("roles")
}

model Department {
  department_id   Int        @id @default(autoincrement())
  department_name String     @unique
  description     String?
  is_deleted      Boolean    @default(false)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt
  employees       Employee[]
  teams           Team[]

  @@map("departments")
}

model Position {
  position_id   Int        @id @default(autoincrement())
  position_name String     @unique
  description   String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  employees     Employee[]

  @@map("positions")
}

model Team {
  team_id       Int      @id @default(autoincrement())
  team_name     String
  department_id Int
  team_lead_id  Int?
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  department Department @relation(fields: [department_id], references: [department_id])
  teamLead   Employee?  @relation("TeamLead", fields: [team_lead_id], references: [employee_id])
  members    Employee[] @relation("TeamMembers")

  @@map("teams")
}

model Employee {
  employee_id       Int       @id @default(autoincrement())
  department_id     Int?
  position_id       Int?
  supervisor_id     Int?
  team_id           Int?
  first_name        String
  last_name         String
  email             String    @unique
  phone             String?
  employment_type   String?
  emergency_contact String?
  profile_photo_url String?
  hire_date         DateTime?
  status            String    @default("Active")
  is_deleted        Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  department      Department?      @relation(fields: [department_id], references: [department_id])
  position        Position?        @relation(fields: [position_id], references: [position_id])
  supervisor      Employee?        @relation("Supervisor", fields: [supervisor_id], references: [employee_id])
  subordinates    Employee[]       @relation("Supervisor")
  user            User?
  taskAssignments TaskAssignment[]
  taskUpdates     TaskUpdate[]
  attendance      Attendance[]
  team            Team?            @relation("TeamMembers", fields: [team_id], references: [team_id])
  ledTeams        Team[]           @relation("TeamLead")

  @@map("employees")
}

model User {
  id                    Int       @id @default(autoincrement())
  employee_id           Int?      @unique
  role_id               Int?
  username              String    @unique
  password              String
  status                String    @default("active")
  reset_token           String?   @unique
  reset_expires         DateTime?
  failed_login_attempts Int       @default(0)
  last_login            DateTime?
  is_deleted            Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  employee          Employee?          @relation(fields: [employee_id], references: [employee_id])
  role              Role?              @relation(fields: [role_id], references: [role_id])
  createdTasks      Task[]             @relation("TaskCreator")
  updatedTasks      Task[]             @relation("TaskUpdater")
  stageHistories    TaskStageHistory[]
  comments          TaskComment[]
  approvals         Approval[]
  attachments       Attachment[]
  notifications     Notification[]     @relation("NotifRecipient")
  sentNotifications Notification[]     @relation("NotifSender")
  activityLogs      ActivityLog[]
  assignedBy        TaskAssignment[]

  @@map("users")
}

model WorkflowStage {
  stage_id    Int      @id @default(autoincrement())
  stage_name  String   @unique
  step_order  Int      @unique
  is_terminal Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tasks           Task[]
  oldStageHistory TaskStageHistory[] @relation("OldStage")
  newStageHistory TaskStageHistory[] @relation("NewStage")

  @@map("workflow_stages")
}

model TaskPriority {
  priority_id   Int      @id @default(autoincrement())
  priority_name String   @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  tasks Task[]

  @@map("task_priorities")
}

model Task {
  task_id            Int       @id @default(autoincrement())
  stage_id           Int
  task_title         String
  task_description   String?   @db.Text
  priority_id        Int
  start_date         DateTime?
  due_date           DateTime
  created_by_user_id Int
  updated_by_user_id Int?
  is_deleted         Boolean   @default(false)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  stage        WorkflowStage      @relation(fields: [stage_id], references: [stage_id])
  priority     TaskPriority       @relation(fields: [priority_id], references: [priority_id])
  creator      User               @relation("TaskCreator", fields: [created_by_user_id], references: [id])
  updater      User?              @relation("TaskUpdater", fields: [updated_by_user_id], references: [id])
  assignments  TaskAssignment[]
  updates      TaskUpdate[]
  stageHistory TaskStageHistory[]
  comments     TaskComment[]
  approvals    Approval[]
  attachments  Attachment[]

  @@map("tasks")
}

model TaskAssignment {
  assignment_id       Int      @id @default(autoincrement())
  task_id             Int
  employee_id         Int
  assigned_by_user_id Int
  assigned_at         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  task       Task     @relation(fields: [task_id], references: [task_id])
  employee   Employee @relation(fields: [employee_id], references: [employee_id])
  assignedBy User     @relation(fields: [assigned_by_user_id], references: [id])

  @@map("task_assignments")
}

model TaskUpdate {
  update_id        Int      @id @default(autoincrement())
  task_id          Int
  employee_id      Int
  update_message   String   @db.Text
  progress_percent Int      @default(0)
  update_date      DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  task     Task     @relation(fields: [task_id], references: [task_id])
  employee Employee @relation(fields: [employee_id], references: [employee_id])

  @@map("task_updates")
}

model TaskStageHistory {
  history_id         Int      @id @default(autoincrement())
  task_id            Int
  changed_by_user_id Int
  old_stage_id       Int?
  new_stage_id       Int
  remarks            String?  @db.Text
  changed_at         DateTime @default(now())
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  task      Task           @relation(fields: [task_id], references: [task_id])
  changedBy User           @relation(fields: [changed_by_user_id], references: [id])
  oldStage  WorkflowStage? @relation("OldStage", fields: [old_stage_id], references: [stage_id])
  newStage  WorkflowStage  @relation("NewStage", fields: [new_stage_id], references: [stage_id])

  @@map("task_stage_history")
}

model TaskComment {
  comment_id   Int      @id @default(autoincrement())
  task_id      Int
  user_id      Int
  comment_text String   @db.Text
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  task Task @relation(fields: [task_id], references: [task_id])
  user User @relation(fields: [user_id], references: [id])

  @@map("task_comments")
}

model Approval {
  approval_id      Int       @id @default(autoincrement())
  task_id          Int
  approver_user_id Int
  approval_status  String
  remarks          String?   @db.Text
  requested_at     DateTime  @default(now())
  approval_date    DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  task     Task @relation(fields: [task_id], references: [task_id])
  approver User @relation(fields: [approver_user_id], references: [id])

  @@map("approvals")
}

model Attachment {
  attachment_id       Int      @id @default(autoincrement())
  task_id             Int
  uploaded_by_user_id Int
  file_name           String
  file_path           String
  file_type           String?
  is_deleted          Boolean  @default(false)
  uploaded_at         DateTime @default(now())
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  task       Task @relation(fields: [task_id], references: [task_id])
  uploadedBy User @relation(fields: [uploaded_by_user_id], references: [id])

  @@map("attachments")
}

model Notification {
  notification_id   Int      @id @default(autoincrement())
  user_id           Int
  sender_user_id    Int?
  notification_type String
  reference_id      Int?
  title             String
  message           String   @db.Text
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user   User  @relation("NotifRecipient", fields: [user_id], references: [id])
  sender User? @relation("NotifSender", fields: [sender_user_id], references: [id])

  @@map("notifications")
}

model Attendance {
  attendance_id     Int      @id @default(autoincrement())
  employee_id       Int
  date              DateTime
  time_in           String?
  time_out          String?
  attendance_status String   @default("Present")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [employee_id])

  @@map("attendance")
}

model ActivityLog {
  log_id         Int      @id @default(autoincrement())
  user_id        Int
  action_type    String
  table_affected String?
  record_id      Int?
  description    String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("activity_logs")
}
